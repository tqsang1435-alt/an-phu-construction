# --- EMAIL NOTIFICATION SETTINGS ---
# Dùng để gửi email thông báo khi có Contact form mới (VD: dùng Resend, SendGrid, Nodemailer)
EMAIL_PROVIDER_API_KEY=your_api_key_here
CONTACT_RECEIVER_EMAIL=project@anphuconstruction.com
EMAIL_FROM=noreply@anphuconstruction.com

# --- STORAGE SETTINGS ---
# Dùng để lưu trữ file hồ sơ đính kèm (VD: AWS S3, Supabase Storage, Vercel Blob)
STORAGE_API_KEY=your_storage_key_here
STORAGE_BUCKET=anphu-attachments
